# Copy this file to /opt/zell-force/.env on the VPS and fill real values there.
# Docker Compose reads /opt/zell-force/.env for variable interpolation.

ZELLFORCE_POSTGRES_PASSWORD=replace-with-vps-db-password
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
