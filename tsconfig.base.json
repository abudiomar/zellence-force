{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@zellforce/config": ["packages/config/src/index.ts"],
      "@zellforce/application": ["packages/application/src/index.ts"],
      "@zellforce/contracts": ["packages/contracts/src/index.ts"],
      "@zellforce/domain": ["packages/domain/src/index.ts"],
      "@zellforce/db": ["packages/db/src/index.ts"],
      "@zellforce/ui": ["packages/ui/src/index.ts"],
      "@zellforce/ui/tokens.css": ["packages/ui/src/tokens/tokens.css"]
    }
  }
}
