{
  "name": "zellforce",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bunx tsc -b",
    "lint": "bun run typecheck",
    "build": "turbo build",
    "ci": "bun run scripts/ci.ts",
    "test:db:integration": "bun run --filter '@zellforce/db' test:integration",
    "bootstrap:owner": "bun run apps/api/src/bootstrap-owner.ts",
    "smoke:workspace": "vitest run tests/platform/workspace-import.test.ts",
    "smoke:env": "vitest run tests/platform/env-schema.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "turbo": "^2.9.18",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
